<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 摄像头权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_LOGS" />
    <!-- 定位：行驶信息条里的经纬度和 GPS 车速（试验项目，1.68.0） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 存储权限 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 13+ 媒体权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 11+ 所有文件访问权限（用于访问U盘公共目录） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- 网络权限：检查更新访问 GitHub；「发送到手机」在局域网里临时提供一个文件 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 检查更新：下载回来的 APK 要交给系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 前台服务权限（Android 9+） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 前台服务类型：摄像头（Android 10+） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- 开发者选项「录制声音」（试验）：环视录像带一路麦克风的声音。打开开关时才请求，不在启动时要 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 录制声音开着时，前台服务试着带上麦克风类型（安卓 11 起后台用麦克风要它；带不上照旧） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- CPU唤醒锁（保持CPU运行，不亮屏，用于息屏状态下拍照/录制） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 悬浮窗权限（绕过后台启动Activity限制，需要用户手动授权） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 开机自启动权限 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 请求电池优化白名单（阻止休眠的关键） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 通知权限（Android 13+，用于显示前台服务通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 使用情况访问：开发者选项「记录可能占用摄像头的应用」查别的程序占用相机前后谁起停了前台服务、切了前后台；
         要在系统设置里单独授予，开发者选项的权限页显示它的状态 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 蓝牙：灵动贴（button.SmartButtons，2026-10-30）。安卓 12 起扫描、连接各一个运行时权限（「附近的设备」），
         neverForLocation 表示不拿蓝牙结果推位置（zeekr-shortcut-lab 在车上就是这么申请的，扫得到灵动贴）；
         更早的安卓扫描要 BLUETOOTH_ADMIN 加定位 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- 声明使用摄像头功能 -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".ZeekrShortcutApp"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Cam">

        <!-- 高优先级保活 Provider：在应用启动的最早阶段初始化服务 -->
        <!-- initOrder="2147483647" 确保最先执行（参考保活效果好的应用） -->
        <provider
            android:name=".KeepAliveProvider"
            android:authorities="${applicationId}.keepalive"
            android:exported="false"
            android:initOrder="2147483647" />

        <!-- FileProvider for sharing video files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 分辨率实测，只从开发者选项进 -->


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务：用于后台录制保护 -->
        <service
            android:name=".CameraForegroundService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <!-- 悬浮窗服务：显示悬浮录制按钮 -->

        <!-- 摄像头录制服务 (D:\yuan重构新增) -->
        <!-- 超级镜子：环视合成流里后方那一路的悬浮窗 -->
        <service
            android:name=".zeekr.RearViewMirrorService"
            android:exported="false" />

        <!-- 盲区画面：打转向灯时显示该侧摄像头画面的悬浮窗 -->
        <service
            android:name=".zeekr.SideViewService"
            android:exported="false" />

        <service
            android:name=".service.CameraRecordingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- 补盲悬浮窗服务 (D:\yuan重构新增) -->
        <!-- 录制悬浮按钮服务 (后台录制控制) -->
        <service
            android:name=".service.RecordingFloatingService"
            android:enabled="true"
            android:exported="false" />

        <!-- 连续时间轴回放（实验性）：把分段拼成一条时间轴，可跨文件拖动 -->
        <!-- 视频回看。用 Theme.Cam 而不是全屏主题：全屏会把窗口铺到
             状态栏底下，顶部的标题和列表被车机状态栏压住。
             跟「软件设置」保持一致，由系统把状态栏那一条留出来。 -->
        <!-- 图片回看：和连续回放一样是独立 Activity，打开它主界面就退到后台 -->
        <activity
            android:name=".playback.PhotoPlaybackActivity"
            android:label="@string/nav_photo_playback"
            android:theme="@style/Theme.Cam"
            android:screenOrientation="landscape"
            android:exported="false" />

        <activity
            android:name=".zeekr.TimelinePlayerActivity"
            android:label="@string/nav_video_playback"
            android:theme="@style/Theme.Cam"
            android:screenOrientation="landscape"
            android:exported="false" />

        <!-- 诊断信息：相机/屏幕/车辆信号/存储/日志，可导出 -->
        <activity
            android:name=".zeekr.DiagnosticsActivity"
            android:label="@string/set_diagnostics_title"
            android:theme="@style/Theme.Cam"
            android:exported="false" />

        <!-- 停车警报调试（开发者选项）：一屏 JSON + 最近黑匣子，可截屏 / 复制 / 存盘 -->
        <activity
            android:name=".alarm.AlertsDebugActivity"
            android:label="@string/alerts_debug_title"
            android:theme="@style/Theme.Cam"
            android:exported="false" />

        <!-- 关于与致谢：说明本应用两个功能来源及其许可证 -->
        <activity
            android:name=".zeekr.AboutActivity"
            android:label="@string/about_title"
            android:theme="@style/Theme.Cam"
            android:exported="false" />

        <!-- 无障碍服务：保活手段之一。系统肯不肯让它跑还没在车上试过，它自己会把结果记进黑匣子 -->
        <service
            android:name=".KeepAliveAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 灵动贴扫描的结果（button.ScanReceiver，2026-11-04）：PendingIntent 扫描由系统用我们自己的身份送来，不导出 -->
        <receiver
            android:name=".button.ScanReceiver"
            android:exported="false" />

        <!-- 开机自启动广播接收器 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- 保活广播接收器：系统有动静时确认一次前台服务在不在（该不该在由相机管家判）。
             2026-11-10 起只留送得到的（项目所有者）：安卓 8 起大多数隐式系统广播不再送给清单里登记的接收器，
             亮屏 / 熄屏、电量、耳机这几种从来只给动态登记的（平台笔记 §3.7）。TIME_TICK 只能动态注册
             （KeepAliveReceiver.registerTimeTick）。要收蓝牙进程发的设备连上 / 断开，只能对外开放。 -->
        <receiver
            android:name=".KeepAliveReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <!-- 蓝牙设备连上 / 断开（车机启动会自动连手机蓝牙） -->
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <!-- USB 设备插拔 -->
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
                <!-- 时区、时间、语言变化 -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <!-- 本应用更新之后 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- 自己发的保活检查（KeepAliveReceiver.sendKeepAliveCheck，带包名） -->
                <action android:name="com.kooo.evcam.ACTION_KEEP_ALIVE" />
            </intent-filter>

            <!-- U 盘挂上 / 卸下 / 移除 / 弹出：广播带 file 数据，要这一组才对得上 -->
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <action android:name="android.intent.action.MEDIA_UNMOUNTED" />
                <action android:name="android.intent.action.MEDIA_REMOVED" />
                <action android:name="android.intent.action.MEDIA_EJECT" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
