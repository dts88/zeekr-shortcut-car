<?xml version="1.0" encoding="utf-8"?>
<!--
  设置行：开关加下一层（SwitchNavPreference，ui-spec §三）。

  行首是开关（和 pref_row 一样的位置），点它只开关；点这一行其余的地方进下一层，
  所以行尾和 pref_row_value 一样写当前值再加 ›。开关那一块从行的左边缘一直到开关右边 18dp
  都算点开关，手指不用对准开关本身。

  id 照 androidx.preference 的默认布局（widget_frame / title / summary），当前值是 pref_value。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_pref_row"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingEnd="14dp">

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="72dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/pref_row_padding_start"
        android:paddingEnd="@dimen/pref_switch_gap" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/pref_title"
            android:textAppearance="@style/TextAppearance.Cam.Body" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="6"
            android:textColor="@color/pref_summary"
            android:textAppearance="@style/TextAppearance.Cam.Micro" />
    </LinearLayout>

    <TextView
        android:id="@+id/pref_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxWidth="360dp"
        android:maxLines="1"
        android:textColor="@color/pref_summary"
        android:textAppearance="@style/TextAppearance.Cam.Caption"
        android:visibility="gone" />

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/text_tertiary" />
</LinearLayout>
