<?xml version="1.0" encoding="utf-8"?>
<!--
  一路相机。一行看完：叫什么、开没开、录成什么样。
  和上面那一档不一样的地方标「已细调」——「我选了均衡，但后座舱不是」这件事必须看得见。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_editor_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/camera_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Cam.Row" />

        <TextView
            android:id="@+id/camera_tuned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_editor_badge"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="2dp"
            android:text="@string/editor_camera_tuned"
            android:textAppearance="@style/TextAppearance.Cam.Caption"
            android:textColor="@color/energy_text"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- SwitchCompat 而不是 MaterialSwitch：主题里的 switchStyle 认的是前者，
             走我们自己的轨道和滑块（白滑块 + 橙轨道），和设置里那些开关一致 -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/camera_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/camera_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.Cam.Caption"
        android:textColor="@color/text_secondary" />
</LinearLayout>
