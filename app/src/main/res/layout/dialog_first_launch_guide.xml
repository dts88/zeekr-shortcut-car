<?xml version="1.0" encoding="utf-8"?>
<!--
  首次启动的引导。内容全部走 @string，中英两份 —— 这一屏是新用户看到的第一段文字，
  它如果只有中文，英文用户从第一眼就开始猜。

  原来这里是上游 EVCam 的说明（车型适配、自定义车型、录制模式），
  还把上游作者标成「本软件作者」。那些内容在这个分支里既不适用也不准确。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/guide_title"
            android:textSize="32sp"
            android:textColor="@color/dialog_guide_title"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/dialog_guide_accent"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="①"
                android:textSize="22sp"
                android:textColor="@color/dialog_guide_accent"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_1"
                android:textSize="22sp"
                android:textColor="@color/dialog_guide_content"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="②"
                android:textSize="22sp"
                android:textColor="@color/dialog_guide_accent"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_2"
                android:textSize="22sp"
                android:textColor="@color/dialog_guide_content"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="③"
                android:textSize="22sp"
                android:textColor="@color/dialog_guide_accent"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_3"
                android:textSize="22sp"
                android:textColor="@color/dialog_guide_content"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="④"
                android:textSize="22sp"
                android:textColor="@color/dialog_guide_accent"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_4"
                android:textSize="22sp"
                android:textColor="@color/dialog_guide_content"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>



        <TextView
            android:id="@+id/btn_confirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/dialog_button_background"
            android:gravity="center"
            android:text="@string/action_got_it_guide"
            android:textColor="@color/dialog_guide_button_text"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
