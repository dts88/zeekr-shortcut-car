<?xml version="1.0" encoding="utf-8"?>
<!--
  设置行：开关加下一层（SwitchNavPreference.showSentryStatus），行尾的当前值下面多一行哨兵模式此刻的状态
  （SentryStatusView 自己读、自己换字）。用在「熄屏持续录制」上：它录不录看哨兵模式，下一层是熄屏后的帧率（2026-11-04）。
  其余和 pref_row_switch_nav 一样。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_pref_row"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingEnd="14dp">

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="72dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/pref_row_padding_start"
        android:paddingEnd="@dimen/pref_switch_gap" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/pref_title"
            android:textAppearance="@style/TextAppearance.Cam.Body" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="6"
            android:textColor="@color/pref_summary"
            android:textAppearance="@style/TextAppearance.Cam.Micro" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pref_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end"
            android:maxWidth="360dp"
            android:maxLines="1"
            android:textColor="@color/pref_summary"
            android:textAppearance="@style/TextAppearance.Cam.Caption"
            android:visibility="gone" />

        <com.kooo.evcam.ui.SentryStatusView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Cam.Caption" />
    </LinearLayout>

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/text_tertiary" />
</LinearLayout>
