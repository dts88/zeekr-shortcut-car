<?xml version="1.0" encoding="utf-8"?>
<!--
  设置行：展开以后的一行分段，行尾隔一道竖线一个按钮（SegmentedItemPreference，ui-spec §十六「地点」的半径：
  200 / 400 / 600 / 1000 m，行尾「自定义」）。卡片的形状、行间的线照 CardItemPreference；没有 ›。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_pref_row_static"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/pref_row_padding_start"
    android:paddingEnd="14dp">

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="@dimen/pref_switch_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/pref_switch_gap"
        android:gravity="center"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/pref_title"
            android:textAppearance="@style/TextAppearance.Cam.Body" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="4"
            android:textColor="@color/pref_summary"
            android:textAppearance="@style/TextAppearance.Cam.Micro" />
    </LinearLayout>

    <!-- 分段选择的底槽，段由 Segments 摆 -->
    <include
        android:id="@+id/segments"
        layout="@layout/pref_segment_track"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp" />

    <View
        android:id="@+id/pref_action_line"
        android:layout_width="1dp"
        android:layout_height="40dp"
        android:layout_marginStart="14dp"
        android:background="@color/line" />

    <TextView
        android:id="@+id/pref_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:background="@drawable/bg_pref_row_action"
        android:gravity="center"
        android:minWidth="88dp"
        android:minHeight="52dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/pref_title"
        android:textAppearance="@style/TextAppearance.Cam.Caption" />
</LinearLayout>
