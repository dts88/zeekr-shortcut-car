<?xml version="1.0" encoding="utf-8"?>
<!--
  ④ 动作栏：这个界面能做的事，按重要性从上往下。三份主界面布局 <include> 同一份。

  按钮：btn_start_record / btn_take_photo / btn_video_playback / btn_photo_playback /
  btn_settings / btn_minimize。四宫格键撤了 —— 放大哪一格改成直接点那一格，再点还原
  （MainActivity.setupCompositeControls），拍照因此独占一行。右下角原来的「×」改成
  「隐藏到后台」；真正的退出在抽屉和设置左栏的最底下。

  主操作只有录制一个：它大一档（132dp），状态由左侧的点（圆 ⇄ 方）和外圈分段进度环表示，
  红色只出现在那一小块上 —— 红标的是「正在录」这件事，不是这个按钮。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/action_rail"
    android:layout_width="@dimen/rail_width"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
      应用名。原来在标题栏左侧，标题栏拆掉之后它归到这一列的顶上 ——
      这一列本来就是「这个界面能做的事」，名字挂在最上面不占画面。
    -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gutter"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/main_title"
        android:textColor="@color/text_primary"
        android:textAppearance="@style/TextAppearance.Cam.Title"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_start_record"
        android:layout_width="match_parent"
        android:layout_height="@dimen/record_button_height"
        android:clickable="true"
        android:contentDescription="@string/record_start"
        android:focusable="true"
        app:cardBackgroundColor="@color/sunken"
        app:cardCornerRadius="@dimen/corner_radius"
        app:cardElevation="0dp"
        app:rippleColor="@color/nav_ripple_color"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="16dp">

            <FrameLayout
                android:layout_width="@dimen/record_ring_size"
                android:layout_height="@dimen/record_ring_size">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/record_ring"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="1000"
                    android:progress="0"
                    app:indicatorColor="@color/recording"
                    app:indicatorSize="@dimen/record_ring_size"
                    app:trackColor="@color/recording_track"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="4dp" />

                <!-- 形状在代码里画：圆角半径和缩放一起动，就是圆 ⇄ 方 -->
                <View
                    android:id="@+id/record_dot"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/record_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/record_start"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Cam.Title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/record_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Cam.Caption" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 拍照独占一行：四宫格键撤了，放大一格改成直接点画面 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_take_photo"
        style="@style/Widget.Cam.RailTile"
        android:layout_width="match_parent"
        android:layout_height="@dimen/rail_tile_height"
        android:layout_marginTop="@dimen/gutter"
        android:text="@string/rail_photo"
        app:icon="@drawable/ic_camera" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gutter"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_video_playback"
            style="@style/Widget.Cam.RailTile"
            android:layout_width="0dp"
            android:layout_height="@dimen/rail_tile_height"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/nav_video_playback"
            app:icon="@drawable/ic_video" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_photo_playback"
            style="@style/Widget.Cam.RailTile"
            android:layout_width="0dp"
            android:layout_height="@dimen/rail_tile_height"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/nav_photo_playback"
            app:icon="@drawable/ic_photo" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings"
            style="@style/Widget.Cam.RailSmall"
            android:layout_width="0dp"
            android:layout_height="@dimen/rail_small_height"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_weight="1"
            android:text="@string/rail_settings"
            app:icon="@drawable/ic_settings" />

        <!--
          隐藏到后台：录制、悬浮按钮照旧，只把界面收起来。
          原来这里是「×退出」，× 既像「关掉这一页」又像「全部退出」，按之前猜不到是哪个。
          真正的退出挪到抽屉和设置左栏的最底下 —— 往下找得到，手滑点不到。
          长按这个键也是退出：长按不会是手滑碰出来的。
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_minimize"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/rail_small_height"
            android:layout_height="@dimen/rail_small_height"
            android:contentDescription="@string/cd_minimize"
            app:icon="@drawable/ic_minimize"
            app:iconTint="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
