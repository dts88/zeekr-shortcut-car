<?xml version="1.0" encoding="utf-8"?>
<!--
  关于页面。

  这一页是「关于这个软件」，不是致谢长文 —— 之前来源说明和免责占了整整两屏，
  把它本该回答的问题（这是什么、谁做的、去哪看）挤没了。

  但两处不能删：GPL-3.0 的继承关系是许可证要求，
  而 openavm-recorder 是「保留所有权利」的项目，本应用借鉴了它公开记录的平台事实，
  「没有复制代码」这句话必须留着。两者都压到一行讲清楚。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menu_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_title"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/about_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#AAFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/about_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.25"
                android:text="给极氪车机做的环视记录仪：把车机那条 360° 合成流录下来，并提供回放、超级后视镜等功能。"
                android:textColor="#DDFFFFFF"
                android:textSize="15sp" />

            <!-- 项目地址 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="项目地址"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/about_link_project"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="github.com/dts88/zeekr-shortcut-car"
                android:textColor="#4FC3F7"
                android:textSize="15sp" />

            <!-- 请作者喝杯咖啡 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="请作者喝杯咖啡"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="PayNow 到 9271 6786。完全自愿，不影响任何功能。"
                android:textColor="#DDFFFFFF"
                android:textSize="15sp" />

            <!-- 开源与来源 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="开源与来源"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.25"
                android:text="本应用以 GNU GPL v3.0 发布，继承自 EVCam（作者 suyunkai）—— 相机、录制、悬浮窗等基础部分来自它。"
                android:textColor="#DDFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/about_link_evcam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="github.com/suyunkai/EVCam"
                android:textColor="#4FC3F7"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.25"
                android:text="极氪车机只提供一条拼好的环视合成流（而不是四个独立摄像头），以及它的排布与渲染限制 —— 这些关键事实由 AVM Recorder（作者 Dantenothing）率先公开记录。该项目保留所有权利，本应用没有复制它的任何代码，只使用了从其公开资料中得到的事实性结论。谨此致谢。"
                android:textColor="#DDFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/about_link_openavm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="github.com/Dantenothing/openavm-recorder"
                android:textColor="#4FC3F7"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/about_link_gpl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="许可证全文：gnu.org/licenses/gpl-3.0.html"
                android:textColor="#4FC3F7"
                android:textSize="15sp" />

            <!-- 安全免责 -->
            <TextView
                android:id="@+id/about_safety_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="安全须知"
                android:textColor="#FF8080"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.25"
                android:text="实验性非官方软件，与极氪（ZEEKR）无任何关联。行车时请以实际路况为准，不要依赖本应用的画面判断路况；录像也不保证一定完整可用。使用风险自负。"
                android:textColor="#DDFFFFFF"
                android:textSize="15sp" />

            <Button
                android:id="@+id/about_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/button_background"
                android:text="关闭"
                android:textColor="@color/button_text"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
