<?xml version="1.0" encoding="utf-8"?>
<!--
  关于与致谢。

  顺序是有意的：先谢人，再说这软件是什么、跟谁借的、怎么对待你的数据、
  出了事算谁的。致谢排在最前面，因为这个项目是别人给的信息攒起来的。

  一处不能删：GPL-3.0 的继承关系是许可证要求，必须留在用户看得见的地方。

  「安全须知」那行标题是开发者选项的入口（点一下弹密码框），换 id 会把它弄丢。

  统一骨架：① 标题区（返回在左上，和主界面的菜单同一个位置）+ ③ 内容区。
  颜色全部走语义色 —— 以前字是写死的白色，换成浅色日间配色后就看不见了。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_close"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/about_title"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Cam.Title"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="28dp"
        android:paddingTop="20dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/about_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:id="@+id/about_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/about_tagline"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_thanks_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_thanks_body"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_credits_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_credits_evcam"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:id="@+id/about_link_evcam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="4dp"
                android:text="github.com/suyunkai/EVCam"
                android:textColor="@color/energy_text"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:id="@+id/about_link_gpl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="4dp"
                android:text="gnu.org/licenses/gpl-3.0.html"
                android:textColor="@color/energy_text"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_project_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_project_body"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:id="@+id/about_link_project"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="4dp"
                android:text="github.com/dts88/zeekr-shortcut-car"
                android:textColor="@color/energy_text"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_privacy_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_privacy_body"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_storage_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_storage_body"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:id="@+id/about_safety_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_safety_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_safety_body"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/about_coffee_title"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_coffee_body"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
