<?xml version="1.0" encoding="utf-8"?>
<!--
  关于页面。

  这一页是「关于这个软件」，不是致谢长文 —— 之前来源说明和免责占了整整两屏，
  把它本该回答的问题（这是什么、谁做的、去哪看）挤没了。

  但两处不能删：GPL-3.0 的继承关系是许可证要求，
  而 openavm-recorder 是「保留所有权利」的项目，本应用借鉴了它公开记录的平台事实，
  「没有复制代码」这句话必须留着。两者都压到一行讲清楚。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menu_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_title"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/about_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#AAFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/about_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/about_tagline"
                android:textColor="#DDFFFFFF"
                android:textSize="15sp" />

            <!-- 存储建议 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/about_storage_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/about_storage_body"
                android:textColor="#DDFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/about_storage_privacy"
                android:textColor="#FFD08080"
                android:textSize="15sp" />

            <!-- 项目地址 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/about_project_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/about_link_project"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="github.com/dts88/zeekr-shortcut-car"
                android:textColor="#4FC3F7"
                android:textSize="15sp" />

            <!-- 请作者喝杯咖啡 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/about_coffee_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/about_coffee_body"
                android:textColor="#DDFFFFFF"
                android:textSize="15sp" />

            <!-- 开源与来源 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/about_credits_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/about_credits_evcam"
                android:textColor="#DDFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/about_link_evcam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="github.com/suyunkai/EVCam"
                android:textColor="#4FC3F7"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/about_credits_openavm"
                android:textColor="#DDFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/about_link_openavm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="github.com/Dantenothing/openavm-recorder"
                android:textColor="#4FC3F7"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/about_link_gpl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/about_license_line"
                android:textColor="#4FC3F7"
                android:textSize="15sp" />

            <!-- 安全免责 -->
            <TextView
                android:id="@+id/about_safety_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/about_safety_title"
                android:textColor="#FF8080"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/about_safety_body"
                android:textColor="#DDFFFFFF"
                android:textSize="15sp" />

            <Button
                android:id="@+id/about_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/button_background"
                android:text="@string/action_close"
                android:textColor="@color/button_text"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
