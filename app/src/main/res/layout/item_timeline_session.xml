<?xml version="1.0" encoding="utf-8"?>
<!--
  连续回放左栏的一项：一条连续时间轴（若干首尾相接的分段）。

  日期由上方的分组标题给出，所以这里不再重复 —— 突出的是这次录制的时间跨度，
  下面一行是时长、总大小和段数。一项不是一个文件，而是一整段连续录制。
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/session_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- 选中条：当前正在播放的那一条 -->
        <View
            android:id="@+id/session_selected_bar"
            android:layout_width="4dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="#FF3B30"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 时间跨度 -->
            <TextView
                android:id="@+id/session_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="12:54 – 13:21" />

            <!-- 时长 · 大小 · 段数 -->
            <TextView
                android:id="@+id/session_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:text="27:04　·　1.2 GB　·　9 段" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
