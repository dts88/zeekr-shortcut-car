<?xml version="1.0" encoding="utf-8"?>
<!--
  连续回放左栏的一项：一条连续时间轴（若干首尾相接的分段）。

  版式沿用 item_video_group：日期、时间、然后是次要信息。
  区别在于这里的一项不是一个文件，而是一整段连续录制，所以次要信息给的是
  总时长、总大小和段数。
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/session_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- 选中条：当前正在播放的那一条 -->
        <View
            android:id="@+id/session_selected_bar"
            android:layout_width="4dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:background="#FF3B30"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/session_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:text="2026-08-29" />

            <TextView
                android:id="@+id/session_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                android:text="12:54 – 13:21" />

            <TextView
                android:id="@+id/session_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:text="27:04　·　1.2 GB　·　9 段" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
