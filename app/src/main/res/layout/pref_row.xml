<?xml version="1.0" encoding="utf-8"?>
<!--
  设置行：开关类。

  开关放在最前面 —— 车机系统设置就是这么摆的：先看到开没开，再看它是什么。
  整行是一块灰底卡片，行与行之间留 8dp 缝，不再用分隔线。

  id 必须和 androidx.preference 的默认布局一致（widget_frame / title / summary），
  Preference 按这些 id 找控件；开关控件由 PreferenceRows 塞进 widget_frame。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_pref_row"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        android:gravity="center"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/pref_title"
            android:textAppearance="@style/TextAppearance.Cam.Body" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="6"
            android:textColor="@color/pref_summary"
            android:textAppearance="@style/TextAppearance.Cam.Micro" />
    </LinearLayout>
</LinearLayout>
