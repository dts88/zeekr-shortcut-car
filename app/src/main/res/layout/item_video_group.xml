<?xml version="1.0" encoding="utf-8"?>
<!--
  图片回看列表里的一组照片：左边四宫格缩略图，右边时间和大小。
  文字由适配器按当前语言填，这里只放预览用的 tools:text；
  缩略图框的深色底是垫在照片下面的，不跟日夜变。
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- 缩略图（四宫格预览） -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="62dp"
            android:background="#000000">

            <!-- 2x2 网格缩略图 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/thumb_front"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#1A1A1A"
                        android:contentDescription="@string/zeekr_lane_front"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#333333" />

                    <ImageView
                        android:id="@+id/thumb_back"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#1A1A1A"
                        android:contentDescription="@string/zeekr_lane_back"
                        android:scaleType="centerCrop" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#333333" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/thumb_left"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#1A1A1A"
                        android:contentDescription="@string/zeekr_lane_left"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#333333" />

                    <ImageView
                        android:id="@+id/thumb_right"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#1A1A1A"
                        android:contentDescription="@string/zeekr_lane_right"
                        android:scaleType="centerCrop" />
                </LinearLayout>
            </LinearLayout>

            <!-- 张数标签（压在缩略图上） -->
            <TextView
                android:id="@+id/video_count_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:background="#80000000"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:textColor="#FFFFFF"
                android:textAppearance="@style/TextAppearance.Cam.Micro"
                tools:text="4张" />
        </FrameLayout>

        <!-- 信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/video_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Body"
                android:textStyle="bold"
                tools:text="2026-01-31" />

            <TextView
                android:id="@+id/video_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Cam.Row"
                android:textStyle="bold"
                tools:text="12:54" />

            <TextView
                android:id="@+id/video_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Caption"
                tools:text="69.94 MB" />
        </LinearLayout>

        <!-- 选中指示器（多选模式用） -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:clickable="false"
            android:contentDescription="@string/cd_selected"
            android:focusable="false"
            android:visibility="gone" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
