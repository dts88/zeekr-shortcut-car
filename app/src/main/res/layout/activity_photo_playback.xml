<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!--
      ① 标题区：和主界面同一套 —— 64dp 高，菜单在左上，界面名紧跟着，
      本界面的动作靠右。按钮都是矢量图标或灰底块，不再用 ☰ ⌂ 这类字符。
    -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:background="@color/bg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/cd_menu"
            app:icon="@drawable/ic_menu" />

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/nav_photo_playback"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Cam.Title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/current_datetime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Cam.Body"
            android:gravity="start|center_vertical" />

        <include
            layout="@layout/layout_playback_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>


    <!-- 主内容区：② 列表栏 · ③ 内容区 -->
    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧：图片列表。宽度和设置页、视频回看的左栏用同一个值 -->
        <FrameLayout
            android:id="@+id/list_container"
            android:layout_width="@dimen/list_width"
            android:layout_height="match_parent"
            android:background="@color/bg">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/photo_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/empty_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/photo_empty"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Body"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 右侧：预览区（占据剩余空间） -->
        <LinearLayout
            android:id="@+id/preview_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@color/preview_background">

            <!-- 四宫格预览区（居中显示） -->
            <FrameLayout
                android:id="@+id/grid_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:gravity="center">

                <!-- 外层容器：保持16:10比例，确保四宫格整体缩放 -->
                <com.kooo.evcam.AspectRatioFrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center">

                    <!-- 多路模式：四宫格 -->
                    <LinearLayout
                        android:id="@+id/multi_view_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@color/preview_grid_divider">

                        <!-- 上排：前、后 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <com.kooo.evcam.AspectRatioFrameLayout
                                android:id="@+id/frame_front"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                        android:layout_weight="1"
android:layout_marginStart="0dp"
                            android:layout_marginEnd="6dp"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="6dp"
                        android:background="@color/preview_frame_background">

                        <ImageView
                            android:id="@+id/image_front"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/label_front"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="8dp"
                            android:background="#80000000"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="@string/zeekr_lane_front"
                            android:textColor="#FFFFFF"
                            android:textAppearance="@style/TextAppearance.Cam.Caption" />

                        <TextView
                            android:id="@+id/placeholder_front"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/photo_no_image"
                            android:textColor="@color/preview_placeholder_text"
                            android:textAppearance="@style/TextAppearance.Cam.Caption"
                            android:visibility="gone" />
                    </com.kooo.evcam.AspectRatioFrameLayout>

                            <com.kooo.evcam.AspectRatioFrameLayout
                                android:id="@+id/frame_back"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:layout_marginEnd="0dp"
                                android:layout_marginTop="0dp"
                                android:layout_marginBottom="6dp"
                                android:background="@color/preview_frame_background">

                        <ImageView
                            android:id="@+id/image_back"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/label_back"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="8dp"
                            android:background="#80000000"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="@string/zeekr_lane_back"
                            android:textColor="#FFFFFF"
                            android:textAppearance="@style/TextAppearance.Cam.Caption" />

                        <TextView
                            android:id="@+id/placeholder_back"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/photo_no_image"
                            android:textColor="@color/preview_placeholder_text"
                            android:textAppearance="@style/TextAppearance.Cam.Caption"
                            android:visibility="gone" />
                    </com.kooo.evcam.AspectRatioFrameLayout>
                </LinearLayout>

                        <!-- 下排：左、右 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <com.kooo.evcam.AspectRatioFrameLayout
                                android:id="@+id/frame_left"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="0dp"
                                android:layout_marginEnd="6dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginBottom="0dp"
                                android:background="@color/preview_frame_background">

                        <ImageView
                            android:id="@+id/image_left"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/label_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="8dp"
                            android:background="#80000000"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="@string/zeekr_lane_left"
                            android:textColor="#FFFFFF"
                            android:textAppearance="@style/TextAppearance.Cam.Caption" />

                        <TextView
                            android:id="@+id/placeholder_left"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/photo_no_image"
                            android:textColor="@color/preview_placeholder_text"
                            android:textAppearance="@style/TextAppearance.Cam.Caption"
                            android:visibility="gone" />
                    </com.kooo.evcam.AspectRatioFrameLayout>

                            <com.kooo.evcam.AspectRatioFrameLayout
                                android:id="@+id/frame_right"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:layout_marginEnd="0dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginBottom="0dp"
                                android:background="@color/preview_frame_background">

                        <ImageView
                            android:id="@+id/image_right"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/label_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="8dp"
                            android:background="#80000000"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="@string/zeekr_lane_right"
                            android:textColor="#FFFFFF"
                            android:textAppearance="@style/TextAppearance.Cam.Caption" />

                        <TextView
                            android:id="@+id/placeholder_right"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/photo_no_image"
                            android:textColor="@color/preview_placeholder_text"
                            android:textAppearance="@style/TextAppearance.Cam.Caption"
                            android:visibility="gone" />
                            </com.kooo.evcam.AspectRatioFrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.kooo.evcam.AspectRatioFrameLayout>

                <!-- 单路模式：全屏显示 -->
                <FrameLayout
                    android:id="@+id/single_view_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:background="@color/preview_frame_background">

                    <ImageView
                        android:id="@+id/image_single"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/label_single"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="#80000000"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/zeekr_lane_front"
                        android:textColor="#FFFFFF"
                        android:textAppearance="@style/TextAppearance.Cam.Caption" />
                </FrameLayout>

                <!-- 无选中状态提示 -->
                <LinearLayout
                    android:id="@+id/no_selection_hint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/photo_pick_hint"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Cam.Row" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/photo_double_tap_hint"
                        android:textColor="@color/text_hint"
                        android:textAppearance="@style/TextAppearance.Cam.Body" />
                </LinearLayout>
            </FrameLayout>

            <!-- 底部控制栏：摄像头切换按钮 -->
            <LinearLayout
                android:id="@+id/controls_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center"
                android:background="@color/preview_controls_background"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="72dp"
                    android:text="@string/photo_mode_multi"
                    android:textAppearance="@style/TextAppearance.Cam.Body"
                    style="@style/Widget.Cam.RailSmall" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send_to_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="72dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_send_to_phone"
                    android:textAppearance="@style/TextAppearance.Cam.Body"
                    style="@style/Widget.Cam.RailSmall" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
