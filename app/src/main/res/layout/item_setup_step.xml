<?xml version="1.0" encoding="utf-8"?>
<!--
  初始设置左边那一列上的一步（setup/SetupFragment）：前面一个圆，里面是第几步；做过的换成勾；现在这一步垫一块中性灰
  （setActivated，和设置左栏选中的那一项同一块底），圆填成能量色。走到过的能点回去。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_pref_header"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="14dp"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/setup_step_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_setup_step_number"
            android:duplicateParentState="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.Cam.Micro"
            android:textColor="@color/setup_step_number" />

        <ImageView
            android:id="@+id/setup_step_check"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/setup_step_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Cam.Body"
        android:textColor="@color/pref_title" />
</LinearLayout>
