<?xml version="1.0" encoding="utf-8"?>
<!--
  连续回放。统一骨架：① 标题区（返回在左上）+ 左栏连续录制列表 + 右侧播放器。

  左上角是菜单键，和主界面同一个位置、同一个图标；右边是刷新、多选、主页，
  和图片回看那一排对齐 —— 两个回看界面从此是一套操作。
  只有画面那一块是黑底（视频本来就该衬黑），其余跟应用配色走 ——
  以前整页是黑的，控制条上的时间写死白色，换成浅色日间配色后就看不见了。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/timeline_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">

        <!-- 菜单键和主界面同一个位置、同一个图标：点开抽屉，不是「返回上一层」 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/timeline_menu"
            style="@style/Widget.Cam.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/cd_menu"
            app:icon="@drawable/ic_menu" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/player_title"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Cam.Title"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左：连续录制列表 -->
        <LinearLayout
            android:layout_width="@dimen/list_width"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/timeline_list_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/msg_scanning_short"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Cam.Caption" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/timeline_session_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <!-- 右：播放器 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/black">

                <!--
                  TextureView 而不是 VideoView：VideoView 内部是 SurfaceView，
                  会在窗口上挖一个洞，画面在洞后面合成 —— 小窗发虚/透明就是这么来的。
                  TextureView 是普通视图，画在窗口里，没有这个问题。
                -->
                <TextureView
                    android:id="@+id/timeline_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <!--
                  切换分段时用它盖住画面，而不是把画面藏起来：
                  一个不透明的 View 画在窗口里、盖在画面上方，遮住画面而不动 surface。
                -->
                <View
                    android:id="@+id/timeline_video_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/black"
                    android:visibility="gone" />

                <!-- 画面上的角标：压在视频上，所以用深色半透明底 + 白字，不跟日夜变 -->
                <TextView
                    android:id="@+id/timeline_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/camera_label_background"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/white"
                    android:textAppearance="@style/TextAppearance.Cam.Caption" />
            </FrameLayout>

            <!-- 进度条与控制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg"
                android:orientation="vertical"
                android:padding="12dp">

                <SeekBar
                    android:id="@+id/timeline_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/timeline_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Cam.Body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/timeline_prev_session"
                        style="@style/Widget.Cam.RailSmall"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/player_prev" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/timeline_play_pause"
                        style="@style/Widget.Cam.RailSmall"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/action_play" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/timeline_next_session"
                        style="@style/Widget.Cam.RailSmall"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/player_next" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/timeline_speed"
                        style="@style/Widget.Cam.RailSmall"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="1.0x" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/timeline_send"
                        style="@style/Widget.Cam.RailSmall"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/action_send_to_phone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ④ 动作栏 -->
        <include
            layout="@layout/layout_playback_rail"
            android:layout_width="@dimen/rail_width"
            android:layout_height="match_parent" />
    </LinearLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- ⑤ 状态条：和主界面同一条 -->
    <include
        layout="@layout/layout_status_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/status_bar_height" />

</LinearLayout>
