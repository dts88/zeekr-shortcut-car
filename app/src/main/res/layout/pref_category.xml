<?xml version="1.0" encoding="utf-8"?>
<!--
  分组名：小号灰字压在一组卡片上方（车机系统里的「Ergonomics」「Parking comfort」）。
  和卡片里的名字从同一条竖线开始（pref_text_start，ui-spec §三「文字对齐」）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="@dimen/pref_text_start"
    android:paddingTop="18dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.Cam.Caption" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_tertiary"
        android:textAppearance="@style/TextAppearance.Cam.Micro" />
</LinearLayout>
