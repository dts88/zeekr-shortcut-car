<?xml version="1.0" encoding="utf-8"?>
<!--
  车机系统式开关：圆角矩形轨道（开是橙色）+ 白色圆角方块滑块。

  id 必须是 switchWidget（SwitchPreferenceCompat 按它找控件）。
  样式显式指定 AppCompat 的那一份：Material 主题默认的开关样式带 thumbTint / trackTint，
  会把这里的轨道和滑块重新着色。
-->
<androidx.appcompat.widget.SwitchCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/switchWidget"
    style="@style/Widget.AppCompat.CompoundButton.Switch"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@null"
    android:clickable="false"
    android:focusable="false"
    android:thumb="@drawable/pref_switch_thumb"
    app:switchMinWidth="56dp"
    app:track="@drawable/pref_switch_track" />
