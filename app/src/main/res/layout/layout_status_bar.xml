<?xml version="1.0" encoding="utf-8"?>
<!--
  ⑤ 状态条（统一骨架的第五个区，见 docs/ui-spec.md）。

  始终在，不随界面变 —— 开车的人只要扫一眼这一条：这次按什么录、还剩多少空间、
  合成流认出来没有。本段录到哪儿在录制键的外圈上，这里不再重复。

  主界面（压在画面底边）和设置（占一行）两处 <include> 进去；视频回看不放：这条写的是
  现在的设置和余量，压在旧录像上会被当成那段录像的参数（2026-10-01）。
  id 一个不改；填内容的是 ui/StatusLine，
  它在自己那一棵树里找这些 id，所以同一个界面里出现两份也不会互相填错。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="18dp">

    <!-- 这次按什么录：帧率上限 · 码率档（取自录制链路真正读的那一份） -->
    <TextView
        android:id="@+id/tv_status_stream"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.Cam.Caption"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_status_storage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.Cam.Caption"
        android:visibility="gone" />

    <!-- 合成流识别结果（尺寸、分隔带、拆分方式）：吃掉剩余宽度，放不下就截断 -->
    <TextView
        android:id="@+id/tv_composite_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/text_tertiary"
        android:textAppearance="@style/TextAppearance.Cam.Caption"
        android:visibility="invisible" />
</LinearLayout>
