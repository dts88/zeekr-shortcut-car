<?xml version="1.0" encoding="utf-8"?>
<!--
  极氪 7X「环视 + 两路座舱」布局。统一骨架：① 标题区 · ③ 内容区 · ④ 动作栏 · ⑤ 状态条。

  内容区三列：环视合成流四宫格 · 两路座舱上下叠放 · 动作栏。
  动作栏用收窄的那一档（rail_width_compact），把宽度让给座舱列 ——
  座舱是 16:10 的画面，列一窄纵向就被压掉一大截。
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:orientation="vertical"
            android:padding="@dimen/gutter">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical">

                <!-- ① 标题区 -->
                <LinearLayout
                    android:id="@+id/title_bar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/title_bar_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_menu"
                        style="@style/Widget.Cam.IconButton"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:contentDescription="@string/cd_menu"
                        app:icon="@drawable/ic_menu" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/main_title"
                        android:textColor="@color/text_primary"
                        android:textAppearance="@style/TextAppearance.Cam.Title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/opt_model_zeekr_multi"
                        android:textColor="@color/text_tertiary"
                        android:textAppearance="@style/TextAppearance.Cam.Caption" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_recording_stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_recording"
                        android:drawableStart="@drawable/chip_dot_recording"
                        android:drawablePadding="8dp"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="7dp"
                        android:textColor="@color/recording_text"
                        android:textAppearance="@style/TextAppearance.Cam.Body"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line" />

                <!-- ③ 内容区 + ④ 动作栏 -->
                <LinearLayout
                    android:id="@+id/main_row"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:padding="@dimen/gutter">

                    <!-- 环视合成流四宫格 -->
                    <FrameLayout
                        android:id="@+id/composite_wrapper"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="22"
                        android:background="@drawable/bg_preview_frame">

                        <com.kooo.evcam.zeekr.FourLaneContainer
                            android:id="@+id/composite_container"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.kooo.evcam.AutoFitTextureView
                                android:id="@+id/texture_front"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </com.kooo.evcam.zeekr.FourLaneContainer>

                        <TextView
                            android:id="@+id/label_front"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_gravity="top|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/camera_label_background"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/lane_surround"
                            android:textColor="#FFFFFF"
                            android:textAppearance="@style/TextAppearance.Cam.Body" />

                        <!--
                          ⑤ 状态条压在画面底边上（见 docs/ui-spec.md）。占一行的话
                          预览就矮 48dp —— 这块屏幕上，内容就是画面本身。
                        -->
                        <include
                            layout="@layout/layout_status_bar"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/status_bar_height"
                            android:layout_gravity="bottom" />
                    </FrameLayout>

                    <!-- 两路座舱，上下叠放 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/gutter"
                        android:layout_weight="14"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_preview_frame">

                            <com.kooo.evcam.AutoFitTextureView
                                android:id="@+id/texture_back"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center" />

                            <TextView
                                android:id="@+id/label_back"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_gravity="top|start"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/camera_label_background"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="@string/slot_cabin_1"
                                android:textColor="#FFFFFF"
                                android:textAppearance="@style/TextAppearance.Cam.Body" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="@dimen/gutter"
                            android:layout_weight="1"
                            android:background="@drawable/bg_preview_frame">

                            <com.kooo.evcam.AutoFitTextureView
                                android:id="@+id/texture_left"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center" />

                            <TextView
                                android:id="@+id/label_left"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_gravity="top|start"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/camera_label_background"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="@string/slot_cabin_2"
                                android:textColor="#FFFFFF"
                                android:textAppearance="@style/TextAppearance.Cam.Body" />
                        </FrameLayout>
                    </LinearLayout>

                    <include
                        layout="@layout/layout_action_rail"
                        android:layout_width="@dimen/rail_width_compact"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/gutter" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 调试信息覆盖层 -->
        <TextView
            android:id="@+id/tv_debug_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="84dp"
            android:background="@drawable/camera_label_background"
            android:fontFamily="monospace"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text=""
            android:textColor="#AAFFFFFF"
            android:textAppearance="@style/TextAppearance.Cam.Micro"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/nav_background"
        android:elevation="8dp"
        android:fitsSystemWindows="false"
        app:dividerInsetEnd="16dp"
        app:dividerInsetStart="16dp"
        app:headerLayout="@layout/nav_header"
        app:itemBackground="@drawable/nav_item_background"
        app:itemHorizontalPadding="16dp"
        app:itemIconPadding="16dp"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/nav_icon_color_selector"
        app:itemTextAppearance="@style/NavigationMenuTextAppearance"
        app:itemTextColor="@color/nav_text_color_selector"
        app:itemVerticalPadding="16dp"
        app:menu="@menu/navigation_menu"
        app:subheaderInsetStart="16dp"
        app:subheaderTextAppearance="@style/NavigationSubheaderTextAppearance" />

</androidx.drawerlayout.widget.DrawerLayout>
