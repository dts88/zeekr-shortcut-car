<?xml version="1.0" encoding="utf-8"?>
<!--
  设置行：两三个选项直接摆在行里（开关合进分段的那一行是「关闭」加三档，四段；SegmentedPreference）。

  下拉框要点两次（开框、选中），而这种行一次就够。选项少的时候，
  还能同时看见「另一个是什么」—— 下拉框收起来之后是看不见的。

  没有 ›：这一行不通往任何地方，点哪一段就是哪一段。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_pref_row_static"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/pref_text_start"
    android:paddingEnd="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Cam.Body"
            android:textColor="@color/pref_title" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="6"
            android:textAppearance="@style/TextAppearance.Cam.Micro"
            android:textColor="@color/pref_summary" />

        <!-- 说明下面一行小字（SegmentedPreference.setNote：盲区画面选中的这一档什么时候显示）；空就不显示 -->
        <TextView
            android:id="@+id/pref_segment_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Cam.Micro"
            android:textColor="@color/pref_summary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 分段选择的底槽，段由 Segments 摆 -->
    <include
        android:id="@+id/segments"
        layout="@layout/pref_segment_track"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp" />
</LinearLayout>
