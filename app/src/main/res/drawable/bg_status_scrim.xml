<?xml version="1.0" encoding="utf-8"?>
<!--
  ⑤ 状态条压在画面上时的底。

  渐变而不是一块平色：平色会在画面上切出一条硬边，看起来像画面被截短了；
  渐变从透明淡入，读得清字，也不喧宾夺主。

  不跟日夜变 —— 它下面永远是摄像头画面，不是界面底色。和画面上那几个角标
  （camera_label_background）同一个道理。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="#00000000"
        android:startColor="#D9000000"
        android:type="linear" />
</shape>
